# ---- Which games to watch -------------------------------------------------------------------------------------
# Steam app IDs (any game with a Workshop works) or names: plateup, bo3, peopleplayground, zomboid, gmod, rimworld,
# tts, cities, wallpaperengine. The app ID is the number in the store URL: store.steampowered.com/app/1599600/
GAMES=plateup,bo3

# Scan what's already on the Workshop when it first starts: none | all | a number (the N most recently updated)
BACKFILL=50

# How often to check for new uploads and updates
POLL_MINUTES=15

# Skip items bigger than this (some maps are 10+ GB)
MAX_ITEM_MB=2048

# ---- Steam account (only for games that block anonymous downloads, e.g. PlateUp) --------------------------------
# Use a spare account that owns the game. After setting it, log in once:  docker compose run --rm guard login
# Your password is typed into SteamCMD and never stored; only Steam's login token is kept in the data volume.
STEAM_USERNAME=

# ---- Alerts ---------------------------------------------------------------------------------------------------
# Discord channel > Edit channel > Integrations > Webhooks > New webhook > Copy URL
DISCORD_WEBHOOK_URL=
# Any URL that accepts a JSON POST (Slack incoming webhooks work too)
WEBHOOK_URL=
# Which verdicts send an alert: malicious, suspicious, clean
NOTIFY_ON=malicious,suspicious
# Where your dashboard is reachable, used for links in alerts (optional)
PUBLIC_URL=

# ---- Protect the mods on this PC -------------------------------------------------------------------------------
# Point at Steam's Workshop folder and new/updated mods on this PC are scanned as Steam installs them; malicious ones
# are moved out to the quarantine. Windows example: C:/Program Files (x86)/Steam/steamapps/workshop/content
STEAM_WORKSHOP_DIR=
# quarantine (move malicious items out) or alert (only tell you)
PROTECT_ACTION=quarantine

# ---- Engines --------------------------------------------------------------------------------------------------
# Local engines for the watcher: clamav, yara, yara-forge, capa (deep-scan always runs all of them)
ENGINES=clamav,yara,yara-forge,capa
# Online multi-engine lookups switch on when you add a free key. Only file hashes are sent unless UPLOAD_UNKNOWN=true.
VIRUSTOTAL_API_KEY=
METADEFENDER_API_KEY=
MALWAREBAZAAR_API_KEY=
# Upload executables those services have never seen, for a full scan (they share uploads with security vendors)
UPLOAD_UNKNOWN=false

# ---- For game developers: ban bad items from YOUR game's Workshop -----------------------------------------------
# A Steamworks publisher Web API key (partner.steamgames.com > Users & Permissions > Manage Groups > Web API key).
PUBLISHER_KEY=
# The app IDs that key may moderate. WorkshopGuard never acts on any other game.
PUBLISHER_APPS=
# off: you review flagged items on the dashboard and click Ban. confirmed: auto-ban when a known-malware engine
# (ClamAV, VirusTotal, MetaDefender, MalwareBazaar, high-confidence YARA Forge) agrees. malicious: any malicious verdict.
AUTO_BAN=off
# Also stop the uploader posting Workshop items for your game when an item is auto-banned
BAN_UPLOADER=false
UPLOADER_BAN_DAYS=0
UPLOADER_BAN_REASON=Your Workshop upload contained malware.
# Password for the dashboard (needed for the Ban buttons). Any user name works.
ADMIN_PASSWORD=
# Set to 0.0.0.0 to let players' games fetch the blocklist from this machine (or put it behind your CDN)
BLOCKLIST_BIND=127.0.0.1

# ---- Optional extras ------------------------------------------------------------------------------------------
# Steam Web API key: only used as a backup way to list items if Steam changes its Workshop page
STEAM_WEB_API_KEY=
# Copy flagged items to /data/quarantine for review
QUARANTINE_FLAGGED=true
# Pages (30 items each) checked per poll for new and updated items
PAGES_PER_POLL=3
