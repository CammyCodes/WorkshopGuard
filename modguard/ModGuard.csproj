<Project Sdk="Microsoft.NET.Sdk">
  <!-- WorkshopGuard ModGuard. Builds WorkshopGuard.ModGuard.dll, or copy src/*.cs straight into a Unity project.
       netstandard2.0 + C# 7.3 so it compiles in any Unity from 2018.4 on (Mono or IL2CPP), with no dependencies. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>WorkshopGuard.ModGuard</AssemblyName>
    <RootNamespace>WorkshopGuard</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>CammyCodes</Authors>
    <Description>Checks mods before a Unity/C# game loads them: hashes, .NET code analysis, file checks, the player's antivirus and WorkshopGuard blocklists.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- NuGet package. CI sets ContinuousIntegrationBuild so Source Link maps to the tagged commit. -->
    <PackageId>WorkshopGuard.ModGuard</PackageId>
    <Title>WorkshopGuard ModGuard</Title>
    <Copyright>Copyright (c) 2026 CammyCodes</Copyright>
    <PackageTags>modding;mods;malware;security;steam-workshop;unity;mod-loader;antivirus</PackageTags>
    <PackageProjectUrl>https://github.com/CammyCodes/WorkshopGuard/tree/main/modguard</PackageProjectUrl>
    <RepositoryUrl>https://github.com/CammyCodes/WorkshopGuard</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>https://github.com/CammyCodes/WorkshopGuard/blob/main/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**;tools/**;samples/**" />
    <None Include="PACKAGE.md;icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
